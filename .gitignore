# ---------- OS / editor ----------
.DS_Store
._*
Thumbs.db
.idea/
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json

# ---------- Node ----------
node_modules/
*.log
npm-debug.log*
yarn-error.log*
.npm/
.eslintcache

# ---------- Expo / React Native ----------
.expo/
.expo-shared/
dist/
web-build/
*.jsbundle
*.orig.*

# Native projects are generated by `expo prebuild`; native config lives in app.config.ts.
# NOTE: apps/mobile/modules/** (local Expo native modules) is deliberately NOT ignored.
/apps/mobile/ios/
/apps/mobile/android/

# Signing material — never commit
*.p8
*.p12
*.mobileprovision
*.keystore
*.jks

# ...with one deliberate exception. This is a DEBUG keystore whose password is the
# well-known 'android'. It is committed so the Android SHA-1 stays identical across machines
# and CI — Google OAuth registers a specific (package, fingerprint) pair, so a per-machine
# keystore would mean sign-in only worked on one laptop. It cannot sign a release: the upload
# key is generated and held by EAS and never lives here.
!apps/mobile/credentials/debug.keystore

# ---------- Secrets / service config ----------
.env
.env.*
!.env.example
google-services.json
GoogleService-Info.plist
supabase/.env
supabase/.branches/
supabase/.temp/
.supabase/

# ---------- Build / test output ----------
coverage/
.turbo/
*.tsbuildinfo
maestro/**/screenshots/
maestro/**/*.mp4

# NOTE: design-reference/screens/support.js and design-reference/assets/image-slot.js are
# vendored third-party prototype-viewer runtime, deliberately tracked so the reference
# screens still render in a browser. See design-reference/README.md.
