# ---------- OS / editor ----------
.DS_Store
._*
Thumbs.db
.idea/
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json

# ---------- Node ----------
node_modules/
*.log
npm-debug.log*
yarn-error.log*
.npm/
.eslintcache

# ---------- Expo / React Native ----------
.expo/
.expo-shared/
dist/
web-build/
*.jsbundle
*.orig.*

# Native projects are generated by `expo prebuild`; native config lives in app.config.ts.
# NOTE: apps/mobile/modules/** (local Expo native modules) is deliberately NOT ignored.
/apps/mobile/ios/
/apps/mobile/android/

# Signing material — never commit
*.p8
*.p12
*.mobileprovision
*.keystore
*.jks

# ---------- Secrets / service config ----------
.env
.env.*
!.env.example
google-services.json
GoogleService-Info.plist
supabase/.env
supabase/.branches/
supabase/.temp/
.supabase/

# ---------- Build / test output ----------
coverage/
.turbo/
*.tsbuildinfo
maestro/**/screenshots/
maestro/**/*.mp4

# ---------- Prototype runtime (not tracked; see design-reference/README.md) ----------
design-reference/**/support.js
design-reference/**/image-slot.js
