# Copy to .env and fill in. .env is gitignored; .env.example is committed.
# Setup instructions: docs/setup-services.md
#
# EXPO_PUBLIC_ variables are inlined into the app bundle at build time, so treat every value
# here as public. That is fine for these — the anon key grants nothing on its own because
# every table sits behind row level security.
#
# NEVER put the Supabase service_role key here. It bypasses RLS entirely and belongs only in
# Edge Function secrets.
#
# --- which file to put things in ----------------------------------------------
# `.env` is what a RELEASE build reads. Put the hosted project here and nothing else.
#
# To point at a local Supabase instead, use **`.env.development.local`** — NOT `.env.local`.
# @expo/env resolves `.env.{mode}.local, .env.local, .env.{mode}, .env` in that order, and
# `.env.local` carries no mode qualifier, so it is loaded in production builds as well and beats
# `.env`. A release built alongside a `.env.local` ships pointing wherever that file says, with
# no symptom on the machine that built it. `.env.development.local` cannot do that: production
# never loads it. Both are gitignored via `.env*.local`.

# --- Supabase -----------------------------------------------------------------
# Local development (npx supabase start prints these). The Android emulator reaches the host
# at 10.0.2.2; the iOS simulator can use 127.0.0.1.
EXPO_PUBLIC_SUPABASE_URL=http://10.0.2.2:54321
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# --- Google sign-in -----------------------------------------------------------
# The Android client ID is deliberately absent: Google matches Android by package name and
# signing certificate, not by an id in the app.
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=

# --- Feature flags ------------------------------------------------------------
# Phone/OTP is built but off for v1: Indian SMS needs TRAI DLT registration and a paid
# provider. Set to 1 once that clears to reveal the button.
EXPO_PUBLIC_ENABLE_PHONE_AUTH=0

# --- Optional services --------------------------------------------------------
# Each of these is a seam: absent means the feature is off and the app builds, runs and ships
# without it. None of them are secrets — every EXPO_PUBLIC_ value is embedded in the bundle and
# readable by anyone who downloads it. Anything that must stay secret belongs in Supabase Vault
# or an EAS secret, never here.

# Crash reporting. A Sentry DSN is designed to be public (it only permits writing events).
# Absent, or any development build, means monitoring is off entirely — see lib/monitoring.ts.
EXPO_PUBLIC_SENTRY_DSN=

# Tip jar. Setting this ENABLES the Send button, so do not set it until store products exist
# AND the iap-verify Edge Function is deployed — see features/tip/purchases.ts.
EXPO_PUBLIC_REVENUECAT_KEY=

# Where "Rate Chukta" sends people when the OS review sheet is unavailable. Fill in once the
# store listings exist.
EXPO_PUBLIC_STORE_URL=

# Public origin for Terms, Privacy and invite links. Defaults to the GitHub Pages URL; point it
# at the real domain once bought — see lib/urls.ts.
EXPO_PUBLIC_SITE_ORIGIN=
